# Server Configuration
NODE_ENV=development
PORT=4000

# CORS Allowlist (comma-separated origins, no wildcard with credentials)
CORS_ORIGINS=http://localhost:5173

# Request Limits
JSON_BODY_LIMIT=100kb

# PostgreSQL Connection String (replace with your local or managed database credentials)
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/finora_dev?schema=public

# Session & Cryptographic Secrets (generate 32+ char random strings for production)
SESSION_SECRET=replace-with-a-secure-random-32-char-secret
CSRF_SECRET=replace-with-a-secure-random-32-char-csrf-secret
COOKIE_NAME=finora_sid
